from pathlib import Path
from PyPDF2 import PdfReader
class KnowledgeBase:
    def __init__(self, knowledge_dir=".", extensions=(".pdf",)):
        self.knowledge_dir = Path(knowledge_dir)
        self.extensions = extensions
        self.docs = self._load_pdfs()
    def _load_pdfs(self):
        """Charge le texte des PDF du dossier knowledge_dir."""
        pdf_texts = {}
        for pdf_file in self.knowledge_dir.glob("*.pdf"):
            try:
                reader = PdfReader(pdf_file)
                text = "".join([page.extract_text() or "" for page in reader.pages])
                pdf_texts[pdf_file.stem] = text
            except Exception as e:
                print(f"Erreur lecture {pdf_file.name}: {e}")
        return pdf_texts
    def query(self, keyword):
        """Recherche un mot clé dans les documents du savoir."""
        results = {}
        for name, text in self.docs.items():
            if keyword.lower() in text.lower():
                results[name] = text[:500] + "..."  # Extrait les premières occurrences
        return results
# Exemple d’utilisation
if __name__ == "__main__":
    kb = KnowledgeBase(".")  # dossier courant
